+import Foundation
+import RoomPlan
+import UIKit
+import simd
+
+struct RoomScanProjectExportPackage: Identifiable {
+    let id = UUID()
+    let folderURL: URL
+    let pdfURL: URL
+    let pngURL: URL
+    let jsonURL: URL
+    let dxfURL: URL
+    let csvURLs: [URL]
+    let manifestURL: URL
+
+    var shareItems: [Any] {
+        [pdfURL, pngURL, jsonURL, dxfURL, manifestURL] + csvURLs
+    }
+}
+
+private struct ProjectExportPoint: Codable {
+    let x: Double
+    let y: Double
+}
+
+private struct ProjectExportRoom: Codable {
+    let roomIndex: Int
+    let identifier: UUID
+    let story: Int
+    let floorElevationMeters: Double
+    let structuralCeilingHeightMeters: Double
+    let finishedCeilingHeightMeters: Double
+    let wallCount: Int
+    let doorCount: Int
+    let windowCount: Int
+    let openingCount: Int
+    let objectCount: Int
+    let acceptedCorrectionCount: Int
+    let floorPolygons: [[ProjectExportPoint]]
+}
+
+private struct ProjectExportWallFace: Codable {
+    let assignmentID: UUID
+    let roomIndex: Int
+    let wallNumber: Int
+    let wallIdentifier: UUID
+    let start: ProjectExportPoint
+    let end: ProjectExportPoint
+    let centerY: Double
+    let lengthMeters: Double
+    let heightMeters: Double
+}
+
+private struct ProjectExportWall: Codable {
+    let buildingWallID: UUID
+    let roomIndices: [Int]
+    let start: ProjectExportPoint
+    let end: ProjectExportPoint
+    let center: ProjectExportPoint
+    let lengthMeters: Double
+    let thicknessMeters: Double
+    let source: String
+    let isShared: Bool
+    let hasReviewIssue: Bool
+    let faces: [ProjectExportWallFace]
+}
+
+private struct ProjectExportOpening: Codable {
+    let identifier: UUID
+    let source: String
+    let kind: String
+    let roomIndex: Int
+    let buildingWallID: UUID?
+    let connectsRoomIndex: Int?
+    let start: ProjectExportPoint
+    let end: ProjectExportPoint
+    let widthMeters: Double
+    let heightMeters: Double
+    let sillHeightMeters: Double
+    let isSuppressed: Bool
+}
+
+private struct ProjectExportCeilingZone: Codable {
+    let identifier: UUID
+    let roomIndex: Int
+    let name: String
+    let kind: String
+    let center: ProjectExportPoint
+    let widthMeters: Double
+    let depthMeters: Double
+    let rotationDegrees: Double
+    let heightAboveFloorMeters: Double
+    let corners: [ProjectExportPoint]
+}
+
+private struct ProjectExportCorrection: Codable {
+    let identifier: UUID
+    let roomIndex: Int
+    let correctionNumber: Int
+    let wallCount: Int
+    let doorCount: Int
+    let windowCount: Int
+    let openingCount: Int
+}
+
+private struct EditableRoomScanProjectDocument: Codable {
+    let schemaVersion: Int
+    let generatedAt: Date
+    let coordinateSystem: String
+    let linearUnit: String
+    let source: String
+    let roomCount: Int
+    let physicalWallCount: Int
+    let sharedWallCount: Int
+    let rooms: [ProjectExportRoom]
+    let walls: [ProjectExportWall]
+    let openings: [ProjectExportOpening]
+    let ceilingZones: [ProjectExportCeilingZone]
+    let corrections: [ProjectExportCorrection]
+    let issues: [ProjectReviewIssue]
+}
+
+private struct ProjectExportManifest: Codable {
+    let schemaVersion: Int
+    let generatedAt: Date
+    let appVersion: String
+    let projectFolder: String?
+    let formats: [String]
+    let files: [String]
+    let notes: [String]
+}
+
+@MainActor
+enum RoomScanProjectExporter {
+    private enum PlanElementKind {
+        case wall
+        case door
+        case window
+        case opening
+        case correction
+    }
+
+    private struct PlanSegment {
+        let id: String
+        let kind: PlanElementKind
+        let start: SIMD2<Double>
+        let end: SIMD2<Double>
+        let thicknessMeters: Double
+        let label: String?
+        let hasIssue: Bool
+    }
+
+    private struct PlanPolygon {
+        let id: String
+        let points: [SIMD2<Double>]
+        let title: String?
+    }
+
+    private struct PlanLabel {
+        let roomIndex: Int
+        let position: SIMD2<Double>
+        let floorMeters: Double
+        let ceilingMeters: Double
+    }
+
+    private struct PlanSnapshot {
+        let floors: [PlanPolygon]
+        let ceilings: [PlanPolygon]
+        let segments: [PlanSegment]
+        let labels: [PlanLabel]
+        let minX: Double
+        let minY: Double
+        let maxX: Double
+        let maxY: Double
+
+        var width: Double { max(maxX - minX, 0.5) }
+        var height: Double { max(maxY - minY, 0.5) }
+    }
+
+    static func export(model: RoomScanViewModel, folder: URL) throws -> RoomScanProjectExportPackage {
+        guard !model.capturedRooms.isEmpty else {
+            throw ExportError.noRooms
+        }
+
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+
+        let generatedAt = Date()
+        let document = makeDocument(model: model, generatedAt: generatedAt)
+        let snapshot = makePlanSnapshot(model: model, document: document)
+
+        let jsonURL = folder.appendingPathComponent("project-model.json")
+        let pdfURL = folder.appendingPathComponent("floor-plan.pdf")
+        let pngURL = folder.appendingPathComponent("floor-plan.png")
+        let dxfURL = folder.appendingPathComponent("floor-plan.dxf")
+        let roomsCSVURL = folder.appendingPathComponent("rooms.csv")
+        let wallsCSVURL = folder.appendingPathComponent("walls.csv")
+        let openingsCSVURL = folder.appendingPathComponent("openings.csv")
+        let ceilingsCSVURL = folder.appendingPathComponent("ceiling-zones.csv")
+        let issuesCSVURL = folder.appendingPathComponent("issues.csv")
+        let manifestURL = folder.appendingPathComponent("export-manifest.json")
+
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        encoder.dateEncodingStrategy = .iso8601
+        try encoder.encode(document).write(to: jsonURL, options: .atomic)
+
+        try renderPNG(snapshot: snapshot, document: document, to: pngURL)
+        try renderPDF(snapshot: snapshot, document: document, to: pdfURL)
+        try makeDXF(snapshot: snapshot, document: document).write(to: dxfURL, atomically: true, encoding: .utf8)
+
+        try writeUTF8CSV(makeRoomsCSV(document.rooms), to: roomsCSVURL)
+        try writeUTF8CSV(makeWallsCSV(document.walls), to: wallsCSVURL)
+        try writeUTF8CSV(makeOpeningsCSV(document.openings), to: openingsCSVURL)
+        try writeUTF8CSV(makeCeilingZonesCSV(document.ceilingZones), to: ceilingsCSVURL)
+        try writeUTF8CSV(makeIssuesCSV(document.issues), to: issuesCSVURL)
+
+        let files = [
+            pdfURL, pngURL, jsonURL, dxfURL,
+            roomsCSVURL, wallsCSVURL, openingsCSVURL, ceilingsCSVURL, issuesCSVURL
+        ]
+        let manifest = ProjectExportManifest(
+            schemaVersion: 1,
+            generatedAt: generatedAt,
+            appVersion: Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String ?? "unknown",
+            projectFolder: model.buildingFolderURL?.lastPathComponent,
+            formats: ["PDF", "PNG", "JSON", "CSV", "DXF"],
+            files: files.map(\.lastPathComponent),
+            notes: [
+                "RoomPlan source files remain unchanged.",
+                "The exported plan includes app-owned wall thickness, geometry, openings, levels and ceiling zones.",
+                "DXF uses meters and English layer names for broad CAD compatibility."
+            ]
+        )
+        try encoder.encode(manifest).write(to: manifestURL, options: .atomic)
+
+        return RoomScanProjectExportPackage(
+            folderURL: folder,
+            pdfURL: pdfURL,
+            pngURL: pngURL,
+            jsonURL: jsonURL,
+            dxfURL: dxfURL,
+            csvURLs: [roomsCSVURL, wallsCSVURL, openingsCSVURL, ceilingsCSVURL, issuesCSVURL],
+            manifestURL: manifestURL
+        )
+    }
+
+    private static func makeDocument(
+        model: RoomScanViewModel,
+        generatedAt: Date
+    ) -> EditableRoomScanProjectDocument {
+        let profiles = Dictionary(uniqueKeysWithValues: model.roomLevelProfiles.map { ($0.roomIndex, $0) })
+        let roomItems = model.capturedRooms.enumerated().map { offset, room -> ProjectExportRoom in
+            let roomIndex = offset + 1
+            let seed = RoomLevelGeometrySeed.make(room: room)
+            let profile = profiles[roomIndex]
+            let floorPolygons: [[ProjectExportPoint]]
+            if room.floors.isEmpty {
+                floorPolygons = [fallbackFloorPolygon(seed: seed).map(exportPoint)]
+            } else {
+                floorPolygons = room.floors.map {
+                    RoomLevelGeometrySeed.floorFootprint(surface: $0)
+                        .map { exportPoint(SIMD2<Double>(Double($0.x), Double($0.y))) }
+                }
+            }
+            return ProjectExportRoom(
+                roomIndex: roomIndex,
+                identifier: room.identifier,
+                story: profile?.story ?? room.story,
+                floorElevationMeters: profile?.floorElevationMeters ?? seed.floorElevationMeters,
+                structuralCeilingHeightMeters: profile?.structuralCeilingHeightMeters ?? seed.structuralCeilingHeightMeters,
+                finishedCeilingHeightMeters: profile?.finishedCeilingHeightMeters ?? seed.structuralCeilingHeightMeters,
+                wallCount: room.walls.count,
+                doorCount: room.doors.count,
+                windowCount: room.windows.count,
+                openingCount: room.openings.count,
+                objectCount: room.objects.count,
+                acceptedCorrectionCount: model.acceptedRoomCorrections.filter { $0.roomIndex == roomIndex }.count,
+                floorPolygons: floorPolygons
+            )
+        }
+
+        let issueWallIDs = Set(model.projectReviewIssues.compactMap(\.buildingWallID))
+        let wallRecordByID = Dictionary(uniqueKeysWithValues: model.buildingWallRecords.map { ($0.id, $0) })
+        let groupedAssignments = Dictionary(grouping: uniqueAssignments(model.roomWallAssignments), by: \.buildingWallID)
+        let wallItems = groupedAssignments.compactMap { buildingWallID, assignments -> ProjectExportWall? in
+            guard let first = assignments.first else { return nil }
+            let baseTangent = normalized(
+                SIMD2<Double>(Double(first.geometry.tangentX), Double(first.geometry.tangentZ)),
+                fallback: SIMD2<Double>(1, 0)
+            )
+            let effectiveItems = assignments.map { assignment -> (RoomWallAssignment, EffectiveWallGeometry, SIMD2<Double>) in
+                let geometry = model.effectiveWallGeometry(for: assignment)
+                var tangent = normalized(
+                    SIMD2<Double>(Double(geometry.tangentX), Double(geometry.tangentZ)),
+                    fallback: baseTangent
+                )
+                if simd_dot(tangent, baseTangent) < 0 { tangent *= -1 }
+                return (assignment, geometry, tangent)
+            }
+            let center = effectiveItems.reduce(SIMD2<Double>(repeating: 0)) {
+                $0 + SIMD2<Double>(Double($1.1.centerX), Double($1.1.centerZ))
+            } / Double(effectiveItems.count)
+            let tangentSum = effectiveItems.reduce(SIMD2<Double>(repeating: 0)) { $0 + $1.2 }
+            let tangent = normalized(tangentSum, fallback: baseTangent)
+            let length = effectiveItems.map { Double($0.1.widthMeters) }.max() ?? Double(first.geometry.widthMeters)
+            let start = center - tangent * (length / 2)
+            let end = center + tangent * (length / 2)
+            let record = wallRecordByID[buildingWallID]
+            let roomIndices = Array(Set(assignments.map(\.roomIndex))).sorted()
+            let faces = effectiveItems.map { assignment, geometry, faceTangent in
+                let faceCenter = SIMD2<Double>(Double(geometry.centerX), Double(geometry.centerZ))
+                let faceLength = Double(geometry.widthMeters)
+                return ProjectExportWallFace(
+                    assignmentID: assignment.id,
+                    roomIndex: assignment.roomIndex,
+                    wallNumber: assignment.wallNumber,
+                    wallIdentifier: assignment.wallIdentifier,
+                    start: exportPoint(faceCenter - faceTangent * (faceLength / 2)),
+                    end: exportPoint(faceCenter + faceTangent * (faceLength / 2)),
+                    centerY: Double(geometry.centerY),
+                    lengthMeters: faceLength,
+                    heightMeters: Double(geometry.heightMeters)
+                )
+            }.sorted { ($0.roomIndex, $0.wallNumber) < ($1.roomIndex, $1.wallNumber) }
+            return ProjectExportWall(
+                buildingWallID: buildingWallID,
+                roomIndices: roomIndices,
+                start: exportPoint(start),
+                end: exportPoint(end),
+                center: exportPoint(center),
+                lengthMeters: length,
+                thicknessMeters: record?.thicknessMeters ?? model.buildingDefaultWallThicknessMeters,
+                source: record?.source.rawValue ?? WallThicknessSource.buildingDefault.rawValue,
+                isShared: roomIndices.count > 1,
+                hasReviewIssue: issueWallIDs.contains(buildingWallID),
+                faces: faces
+            )
+        }.sorted {
+            let lhsRoom = $0.roomIndices.first ?? Int.max
+            let rhsRoom = $1.roomIndices.first ?? Int.max
+            return (lhsRoom, $0.buildingWallID.uuidString) < (rhsRoom, $1.buildingWallID.uuidString)
+        }
+
+        var openingItems: [ProjectExportOpening] = []
+        for record in model.resolvedManualOpeningRecords {
+            let tangent = normalized(
+                SIMD2<Double>(Double(record.tangentX), Double(record.tangentZ)),
+                fallback: SIMD2<Double>(1, 0)
+            )
+            let center = SIMD2<Double>(Double(record.centerX), Double(record.centerZ))
+            openingItems.append(
+                ProjectExportOpening(
+                    identifier: record.id,
+                    source: "manual",
+                    kind: record.kind.rawValue,
+                    roomIndex: record.sourceRoomIndex,
+                    buildingWallID: record.buildingWallID,
+                    connectsRoomIndex: record.connectsRoomIndex,
+                    start: exportPoint(center - tangent * (record.widthMeters / 2)),
+                    end: exportPoint(center + tangent * (record.widthMeters / 2)),
+                    widthMeters: record.widthMeters,
+                    heightMeters: record.heightMeters,
+                    sillHeightMeters: record.sillHeightMeters,
+                    isSuppressed: false
+                )
+            )
+        }
+
+        for (offset, room) in model.capturedRooms.enumerated() {
+            let roomIndex = offset + 1
+            func appendDetected(_ surfaces: [CapturedRoom.Surface], kind: String) {
+                for surface in surfaces {
+                    let center = SIMD2<Double>(Double(surface.transform.columns.3.x), Double(surface.transform.columns.3.z))
+                    let tangent = normalized(
+                        SIMD2<Double>(Double(surface.transform.columns.0.x), Double(surface.transform.columns.0.z)),
+                        fallback: SIMD2<Double>(1, 0)
+                    )
+                    let width = Double(max(surface.dimensions.x, 0.05))
+                    let assignment = surface.parentIdentifier.flatMap { parentID in
+                        model.roomWallAssignments.first {
+                            $0.roomIndex == roomIndex && $0.wallIdentifier == parentID
+                        }
+                    }
+                    openingItems.append(
+                        ProjectExportOpening(
+                            identifier: surface.identifier,
+                            source: "roomPlan",
+                            kind: kind,
+                            roomIndex: roomIndex,
+                            buildingWallID: assignment?.buildingWallID,
+                            connectsRoomIndex: nil,
+                            start: exportPoint(center - tangent * (width / 2)),
+                            end: exportPoint(center + tangent * (width / 2)),
+                            widthMeters: width,
+                            heightMeters: Double(max(surface.dimensions.y, 0.05)),
+                            sillHeightMeters: 0,
+                            isSuppressed: model.suppressedSurfaceIdentifiers.contains(surface.identifier)
+                        )
+                    )
+                }
+            }
+            appendDetected(room.doors, kind: ManualOpeningKind.door.rawValue)
+            appendDetected(room.windows, kind: ManualOpeningKind.window.rawValue)
+            appendDetected(room.openings, kind: ManualOpeningKind.opening.rawValue)
+        }
+        openingItems.sort { ($0.roomIndex, $0.kind, $0.identifier.uuidString) < ($1.roomIndex, $1.kind, $1.identifier.uuidString) }
+
+        let ceilingItems = model.ceilingZoneRecords.map { zone -> ProjectExportCeilingZone in
+            let corners = ceilingCorners(zone).map(exportPoint)
+            return ProjectExportCeilingZone(
+                identifier: zone.id,
+                roomIndex: zone.roomIndex,
+                name: zone.name,
+                kind: zone.kind.rawValue,
+                center: ProjectExportPoint(x: zone.centerX, y: zone.centerZ),
+                widthMeters: zone.widthMeters,
+                depthMeters: zone.depthMeters,
+                rotationDegrees: zone.rotationDegrees,
+                heightAboveFloorMeters: zone.heightAboveFloorMeters,
+                corners: corners
+            )
+        }.sorted { ($0.roomIndex, $0.name, $0.identifier.uuidString) < ($1.roomIndex, $1.name, $1.identifier.uuidString) }
+
+        let correctionItems = model.acceptedRoomCorrections.map { correction in
+            ProjectExportCorrection(
+                identifier: correction.id,
+                roomIndex: correction.roomIndex,
+                correctionNumber: correction.record.correctionNumber,
+                wallCount: correction.room.walls.count,
+                doorCount: correction.room.doors.count,
+                windowCount: correction.room.windows.count,
+                openingCount: correction.room.openings.count
+            )
+        }
+
+        return EditableRoomScanProjectDocument(
+            schemaVersion: 1,
+            generatedAt: generatedAt,
+            coordinateSystem: "RoomPlan shared AR world space; X/Z exported as 2D X/Y",
+            linearUnit: "meter",
+            source: "RoomPlan plus non-destructive 3ELiDAR review layers",
+            roomCount: model.roomCount,
+            physicalWallCount: wallItems.count,
+            sharedWallCount: wallItems.filter(\.isShared).count,
+            rooms: roomItems,
+            walls: wallItems,
+            openings: openingItems,
+            ceilingZones: ceilingItems,
+            corrections: correctionItems,
+            issues: model.projectReviewIssues
+        )
+    }
+
+    private static func makePlanSnapshot(
+        model: RoomScanViewModel,
+        document: EditableRoomScanProjectDocument
+    ) -> PlanSnapshot {
+        let floorPolygons = document.rooms.flatMap { room in
+            room.floorPolygons.enumerated().map { offset, points in
+                PlanPolygon(
+                    id: "floor-\(room.roomIndex)-\(offset)",
+                    points: points.map { SIMD2<Double>($0.x, $0.y) },
+                    title: nil
+                )
+            }
+        }
+        let ceilingPolygons = document.ceilingZones.map { zone in
+            PlanPolygon(
+                id: zone.identifier.uuidString,
+                points: zone.corners.map { SIMD2<Double>($0.x, $0.y) },
+                title: zone.name.isEmpty ? zone.kind : zone.name
+            )
+        }
+
+        var segments = document.walls.map { wall in
+            PlanSegment(
+                id: wall.buildingWallID.uuidString,
+                kind: .wall,
+                start: SIMD2<Double>(wall.start.x, wall.start.y),
+                end: SIMD2<Double>(wall.end.x, wall.end.y),
+                thicknessMeters: wall.thicknessMeters,
+                label: String(format: "%.2f m / %.0f cm", wall.lengthMeters, wall.thicknessMeters * 100),
+                hasIssue: wall.hasReviewIssue
+            )
+        }
+        for opening in document.openings where !opening.isSuppressed {
+            let kind: PlanElementKind
+            switch opening.kind {
+            case ManualOpeningKind.door.rawValue: kind = .door
+            case ManualOpeningKind.window.rawValue: kind = .window
+            default: kind = .opening
+            }
+            segments.append(
+                PlanSegment(
+                    id: opening.identifier.uuidString,
+                    kind: kind,
+                    start: SIMD2<Double>(opening.start.x, opening.start.y),
+                    end: SIMD2<Double>(opening.end.x, opening.end.y),
+                    thicknessMeters: 0,
+                    label: nil,
+                    hasIssue: false
+                )
+            )
+        }
+        for correction in model.acceptedRoomCorrections {
+            for wall in correction.room.walls {
+                let center = SIMD2<Double>(Double(wall.transform.columns.3.x), Double(wall.transform.columns.3.z))
+                let tangent = normalized(
+                    SIMD2<Double>(Double(wall.transform.columns.0.x), Double(wall.transform.columns.0.z)),
+                    fallback: SIMD2<Double>(1, 0)
+                )
+                let half = Double(max(wall.dimensions.x, 0.05)) / 2
+                segments.append(
+                    PlanSegment(
+                        id: "correction-\(correction.id.uuidString)-\(wall.identifier.uuidString)",
+                        kind: .correction,
+                        start: center - tangent * half,
+                        end: center + tangent * half,
+                        thicknessMeters: 0,
+                        label: nil,
+                        hasIssue: false
+                    )
+                )
+            }
+        }
+
+        let labels = document.rooms.map { room -> PlanLabel in
+            let points = room.floorPolygons.flatMap { $0 }.map { SIMD2<Double>($0.x, $0.y) }
+            let position: SIMD2<Double>
+            if points.isEmpty {
+                let wallPoints = document.walls
+                    .filter { $0.roomIndices.contains(room.roomIndex) }
+                    .map { SIMD2<Double>($0.center.x, $0.center.y) }
+                position = average(wallPoints) ?? SIMD2<Double>(repeating: 0)
+            } else {
+                position = average(points) ?? SIMD2<Double>(repeating: 0)
+            }
+            return PlanLabel(
+                roomIndex: room.roomIndex,
+                position: position,
+                floorMeters: room.floorElevationMeters,
+                ceilingMeters: room.finishedCeilingHeightMeters
+            )
+        }
+
+        let allPoints = floorPolygons.flatMap(\.points)
+            + ceilingPolygons.flatMap(\.points)
+            + segments.flatMap { [$0.start, $0.end] }
+        let minX = allPoints.map(\.x).min() ?? -1
+        let maxX = allPoints.map(\.x).max() ?? 1
+        let minY = allPoints.map(\.y).min() ?? -1
+        let maxY = allPoints.map(\.y).max() ?? 1
+
+        return PlanSnapshot(
+            floors: floorPolygons,
+            ceilings: ceilingPolygons,
+            segments: segments,
+            labels: labels,
+            minX: minX,
+            minY: minY,
+            maxX: maxX,
+            maxY: maxY
+        )
+    }
+
+    private static func renderPNG(
+        snapshot: PlanSnapshot,
+        document: EditableRoomScanProjectDocument,
+        to url: URL
+    ) throws {
+        let size = CGSize(width: 2400, height: 1800)
+        let format = UIGraphicsImageRendererFormat()
+        format.scale = 1
+        format.opaque = true
+        let renderer = UIGraphicsImageRenderer(size: size, format: format)
+        let image = renderer.image { rendererContext in
+            drawPlan(
+                context: rendererContext.cgContext,
+                rect: CGRect(origin: .zero, size: size),
+                snapshot: snapshot,
+                document: document,
+                title: "3ELiDAR - مخطط المشروع المعدل"
+            )
+        }
+        guard let data = image.pngData() else { throw ExportError.cannotEncodePNG }
+        try data.write(to: url, options: .atomic)
+    }
