+    private static func renderPDF(
+        snapshot: PlanSnapshot,
+        document: EditableRoomScanProjectDocument,
+        to url: URL
+    ) throws {
+        let pageRect = CGRect(x: 0, y: 0, width: 1190.55, height: 841.89)
+        let format = UIGraphicsPDFRendererFormat()
+        format.documentInfo = [
+            kCGPDFContextTitle as String: "3ELiDAR Edited Floor Plan",
+            kCGPDFContextCreator as String: "3ELiDAR"
+        ]
+        let renderer = UIGraphicsPDFRenderer(bounds: pageRect, format: format)
+        try renderer.writePDF(to: url) { context in
+            context.beginPage()
+            drawPlan(
+                context: context.cgContext,
+                rect: pageRect,
+                snapshot: snapshot,
+                document: document,
+                title: "3ELiDAR - مخطط المشروع المعدل"
+            )
+
+            let reportLines = makeReportLines(document: document)
+            let linesPerPage = 38
+            for chunkStart in stride(from: 0, to: reportLines.count, by: linesPerPage) {
+                context.beginPage()
+                let chunkEnd = min(chunkStart + linesPerPage, reportLines.count)
+                drawReportPage(
+                    context: context.cgContext,
+                    rect: pageRect,
+                    lines: Array(reportLines[chunkStart..<chunkEnd]),
+                    pageNumber: chunkStart / linesPerPage + 2
+                )
+            }
+        }
+    }
