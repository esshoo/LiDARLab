+    private static func drawReportPage(
+        context: CGContext,
+        rect: CGRect,
+        lines: [String],
+        pageNumber: Int
+    ) {
+        context.setFillColor(UIColor.white.cgColor)
+        context.fill(rect)
+        drawText(
+            "3ELiDAR - تقرير بيانات المشروع",
+            in: CGRect(x: 50, y: 35, width: rect.width - 100, height: 40),
+            font: .boldSystemFont(ofSize: 24),
+            color: .label,
+            alignment: .right
+        )
+        drawText(
+            "صفحة \(pageNumber)",
+            in: CGRect(x: 50, y: rect.height - 40, width: rect.width - 100, height: 20),
+            font: .systemFont(ofSize: 10),
+            color: .secondaryLabel,
+            alignment: .center
+        )
+        var y: CGFloat = 92
+        for line in lines {
+            let isHeading = line.hasPrefix("## ")
+            let text = isHeading ? String(line.dropFirst(3)) : line
+            drawText(
+                text,
+                in: CGRect(x: 60, y: y, width: rect.width - 120, height: isHeading ? 28 : 18),
+                font: isHeading ? .boldSystemFont(ofSize: 17) : .systemFont(ofSize: 11),
+                color: isHeading ? .label : .darkGray,
+                alignment: .right
+            )
+            y += isHeading ? 34 : 18
+        }
+    }
