+    private static func drawPlan(
+        context: CGContext,
+        rect: CGRect,
+        snapshot: PlanSnapshot,
+        document: EditableRoomScanProjectDocument,
+        title: String
+    ) {
+        context.setFillColor(UIColor.white.cgColor)
+        context.fill(rect)
+
+        let headerHeight: CGFloat = max(74, rect.height * 0.09)
+        let footerHeight: CGFloat = max(54, rect.height * 0.07)
+        let planRect = rect.insetBy(dx: rect.width * 0.045, dy: 0)
+            .inset(by: UIEdgeInsets(top: headerHeight, left: 0, bottom: footerHeight, right: 0))
+
+        drawText(
+            title,
+            in: CGRect(x: rect.minX + 36, y: rect.minY + 22, width: rect.width - 72, height: 34),
+            font: .boldSystemFont(ofSize: rect.width > 1500 ? 34 : 22),
+            color: .label,
+            alignment: .right
+        )
+        let subtitle = "الغرف: \(document.roomCount)   الحوائط: \(document.physicalWallCount)   المشتركة: \(document.sharedWallCount)   المشكلات: \(document.issues.count)"
+        drawText(
+            subtitle,
+            in: CGRect(x: rect.minX + 36, y: rect.minY + 55, width: rect.width - 72, height: 25),
+            font: .systemFont(ofSize: rect.width > 1500 ? 21 : 13),
+            color: .secondaryLabel,
+            alignment: .right
+        )
+
+        let transform = makeDrawingTransform(snapshot: snapshot, rect: planRect)
+
+        context.saveGState()
+        context.setFillColor(UIColor.systemBrown.withAlphaComponent(0.07).cgColor)
+        context.setStrokeColor(UIColor.systemBrown.withAlphaComponent(0.35).cgColor)
+        context.setLineWidth(1)
+        context.setLineDash(phase: 0, lengths: [6, 4])
+        for floor in snapshot.floors where floor.points.count >= 3 {
+            let path = polygonPath(points: floor.points, transform: transform)
+            context.addPath(path)
+            context.drawPath(using: .fillStroke)
+        }
+        context.restoreGState()
+
+        context.saveGState()
+        context.setFillColor(UIColor.systemIndigo.withAlphaComponent(0.08).cgColor)
+        context.setStrokeColor(UIColor.systemIndigo.withAlphaComponent(0.75).cgColor)
+        context.setLineWidth(1.5)
+        context.setLineDash(phase: 0, lengths: [8, 5])
+        for ceiling in snapshot.ceilings where ceiling.points.count >= 3 {
+            let path = polygonPath(points: ceiling.points, transform: transform)
+            context.addPath(path)
+            context.drawPath(using: .fillStroke)
+        }
+        context.restoreGState()
+
+        for segment in snapshot.segments {
+            let start = transform.point(segment.start)
+            let end = transform.point(segment.end)
+            switch segment.kind {
+            case .wall:
+                drawWall(
+                    context: context,
+                    start: start,
+                    end: end,
+                    thicknessPixels: max(CGFloat(segment.thicknessMeters) * transform.scale, 2.5),
+                    hasIssue: segment.hasIssue
+                )
+                if let label = segment.label {
+                    drawRotatedLabel(context: context, text: label, start: start, end: end)
+                }
+            case .door:
+                drawLine(context: context, start: start, end: end, color: .systemOrange, width: 5)
+            case .window:
+                drawLine(context: context, start: start, end: end, color: .systemBlue, width: 5)
+            case .opening:
+                drawLine(context: context, start: start, end: end, color: .systemTeal, width: 5)
+            case .correction:
+                context.saveGState()
+                context.setLineDash(phase: 0, lengths: [8, 5])
+                drawLine(context: context, start: start, end: end, color: .systemPurple, width: 3)
+                context.restoreGState()
+            }
+        }
+
+        for label in snapshot.labels {
+            let point = transform.point(label.position)
+            let text = "غرفة \(label.roomIndex)\nأرضية \(Int((label.floorMeters * 100).rounded())) سم - سقف \(Int((label.ceilingMeters * 100).rounded())) سم"
+            drawText(
+                text,
+                in: CGRect(x: point.x - 85, y: point.y - 24, width: 170, height: 50),
+                font: .boldSystemFont(ofSize: rect.width > 1500 ? 18 : 10),
+                color: .label,
+                alignment: .center
+            )
+        }
+
+        drawScaleBar(context: context, rect: planRect, scale: transform.scale)
+        drawLegend(context: context, rect: CGRect(x: rect.minX + 36, y: rect.maxY - footerHeight + 8, width: rect.width - 72, height: footerHeight - 14))
+    }
