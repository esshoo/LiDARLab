+    private static func makeReportLines(document: EditableRoomScanProjectDocument) -> [String] {
+        var lines: [String] = [
+            "## ملخص المشروع",
+            "تاريخ التصدير: \(document.generatedAt.formatted(date: .long, time: .shortened))",
+            "عدد الغرف: \(document.roomCount)",
+            "عدد الحوائط الفعلية: \(document.physicalWallCount)",
+            "عدد الحوائط المشتركة: \(document.sharedWallCount)",
+            "عدد الأبواب والنوافذ والفتحات: \(document.openings.filter { !$0.isSuppressed }.count)",
+            "عدد مناطق السقف: \(document.ceilingZones.count)",
+            "عدد المشكلات: \(document.issues.count)",
+            ""
+        ]
+        lines.append("## الغرف")
+        for room in document.rooms {
+            lines.append(
+                "غرفة \(room.roomIndex): دور \(room.story)، أرضية \(formatMeters(room.floorElevationMeters))، سقف تشطيب \(formatMeters(room.finishedCeilingHeightMeters))، \(room.wallCount) حائط، \(room.doorCount) باب"
+            )
+        }
+        lines.append("")
+        lines.append("## الحوائط")
+        for wall in document.walls {
+            let rooms = wall.roomIndices.map(String.init).joined(separator: ",")
+            lines.append(
+                "\(wall.buildingWallID.uuidString.prefix(8)): غرف [\(rooms)]، طول \(formatMeters(wall.lengthMeters))، سماكة \(Int((wall.thicknessMeters * 100).rounded())) سم\(wall.hasReviewIssue ? "، يحتاج مراجعة" : "")"
+            )
+        }
+        if !document.issues.isEmpty {
+            lines.append("")
+            lines.append("## المشكلات")
+            for issue in document.issues {
+                lines.append("[\(issue.severity.arabicTitle)] \(issue.title): \(issue.details)")
