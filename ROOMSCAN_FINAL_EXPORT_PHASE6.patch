+    private static func makeDXF(
+        snapshot: PlanSnapshot,
+        document: EditableRoomScanProjectDocument
+    ) -> String {
+        var lines: [String] = []
+        func pair(_ code: Int, _ value: String) {
+            lines.append(String(code))
+            lines.append(value)
+        }
+        func number(_ value: Double) -> String {
+            String(format: "%.6f", locale: Locale(identifier: "en_US_POSIX"), value)
+        }
+        func addLayer(_ name: String, color: Int) {
+            pair(0, "LAYER")
+            pair(2, name)
+            pair(70, "0")
+            pair(62, String(color))
+            pair(6, "CONTINUOUS")
+        }
+        func addLine(_ layer: String, start: SIMD2<Double>, end: SIMD2<Double>) {
+            pair(0, "LINE")
+            pair(8, layer)
+            pair(10, number(start.x))
+            pair(20, number(start.y))
+            pair(30, "0.0")
+            pair(11, number(end.x))
+            pair(21, number(end.y))
+            pair(31, "0.0")
+        }
+        func addPolyline(_ layer: String, points: [SIMD2<Double>], closed: Bool) {
+            guard points.count >= 2 else { return }
+            pair(0, "LWPOLYLINE")
+            pair(8, layer)
+            pair(90, String(points.count))
+            pair(70, closed ? "1" : "0")
+            for point in points {
+                pair(10, number(point.x))
+                pair(20, number(point.y))
+            }
+        }
+        func addText(_ layer: String, text: String, point: SIMD2<Double>, height: Double) {
+            pair(0, "TEXT")
+            pair(8, layer)
+            pair(10, number(point.x))
+            pair(20, number(point.y))
+            pair(30, "0.0")
+            pair(40, number(height))
+            pair(1, text)
+        }
+
+        pair(0, "SECTION")
+        pair(2, "HEADER")
+        pair(9, "$ACADVER")
+        pair(1, "AC1027")
+        pair(9, "$INSUNITS")
+        pair(70, "6")
+        pair(0, "ENDSEC")
+
+        pair(0, "SECTION")
+        pair(2, "TABLES")
+        pair(0, "TABLE")
+        pair(2, "LAYER")
+        pair(70, "9")
+        addLayer("WALLS", color: 7)
+        addLayer("DOORS", color: 30)
+        addLayer("WINDOWS", color: 5)
+        addLayer("OPENINGS", color: 3)
+        addLayer("FLOORS", color: 33)
+        addLayer("CEILINGS", color: 6)
+        addLayer("CORRECTIONS", color: 200)
+        addLayer("ROOMS", color: 2)
+        addLayer("ISSUES", color: 1)
+        pair(0, "ENDTAB")
+        pair(0, "ENDSEC")
+
+        pair(0, "SECTION")
+        pair(2, "ENTITIES")
+
+        for floor in snapshot.floors {
+            addPolyline("FLOORS", points: floor.points, closed: true)
+        }
+        for ceiling in snapshot.ceilings {
+            addPolyline("CEILINGS", points: ceiling.points, closed: true)
+        }
+        for segment in snapshot.segments {
+            switch segment.kind {
+            case .wall:
+                let axis = normalized(segment.end - segment.start, fallback: SIMD2<Double>(1, 0))
+                let normal = SIMD2<Double>(-axis.y, axis.x)
+                let half = max(segment.thicknessMeters, 0.01) / 2
+                let polygon = [
+                    segment.start + normal * half,
+                    segment.end + normal * half,
+                    segment.end - normal * half,
+                    segment.start - normal * half
+                ]
+                addPolyline(segment.hasIssue ? "ISSUES" : "WALLS", points: polygon, closed: true)
+            case .door:
+                addLine("DOORS", start: segment.start, end: segment.end)
+            case .window:
+                addLine("WINDOWS", start: segment.start, end: segment.end)
+            case .opening:
+                addLine("OPENINGS", start: segment.start, end: segment.end)
+            case .correction:
+                addLine("CORRECTIONS", start: segment.start, end: segment.end)
+            }
+        }
+        for label in snapshot.labels {
+            addText("ROOMS", text: "ROOM_\(label.roomIndex)", point: label.position, height: 0.20)
+        }
+
+        pair(0, "ENDSEC")
+        pair(0, "EOF")
+        return lines.joined(separator: "\n") + "\n"
+    }
