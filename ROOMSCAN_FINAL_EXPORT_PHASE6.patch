+    private static func fallbackFloorPolygon(seed: RoomLevelGeometrySeed) -> [SIMD2<Double>] {
+        let angle = seed.rotationDegrees * .pi / 180
+        let axis = SIMD2<Double>(cos(angle), sin(angle))
+        let normal = SIMD2<Double>(-axis.y, axis.x)
+        let center = SIMD2<Double>(seed.centerX, seed.centerZ)
+        let halfWidth = seed.widthMeters / 2
+        let halfDepth = seed.depthMeters / 2
+        return [
+            center - axis * halfWidth - normal * halfDepth,
+            center + axis * halfWidth - normal * halfDepth,
+            center + axis * halfWidth + normal * halfDepth,
+            center - axis * halfWidth + normal * halfDepth
+        ]
+    }
+
+    private static func ceilingCorners(_ zone: CeilingZoneRecord) -> [SIMD2<Double>] {
+        let angle = zone.rotationDegrees * .pi / 180
+        let axis = SIMD2<Double>(cos(angle), sin(angle))
+        let normal = SIMD2<Double>(-axis.y, axis.x)
+        let center = SIMD2<Double>(zone.centerX, zone.centerZ)
+        let halfWidth = zone.widthMeters / 2
+        let halfDepth = zone.depthMeters / 2
+        return [
+            center - axis * halfWidth - normal * halfDepth,
+            center + axis * halfWidth - normal * halfDepth,
+            center + axis * halfWidth + normal * halfDepth,
+            center - axis * halfWidth + normal * halfDepth
+        ]
+    }
+
+    private static func normalized(_ value: SIMD2<Double>, fallback: SIMD2<Double>) -> SIMD2<Double> {
+        let length = simd_length(value)
+        return length > 0.000001 ? value / length : fallback
+    }
+
+    private static func average(_ values: [SIMD2<Double>]) -> SIMD2<Double>? {
+        guard !values.isEmpty else { return nil }
+        return values.reduce(SIMD2<Double>(repeating: 0), +) / Double(values.count)
+    }
+
+    private static func formatMeters(_ value: Double) -> String {
+        String(format: "%.2f م", value)
+    }
+
+    private struct DrawingTransform {
+        let scale: CGFloat
+        let centerX: CGFloat
+        let centerY: CGFloat
+        let rect: CGRect
+
+        func point(_ world: SIMD2<Double>) -> CGPoint {
+            CGPoint(
+                x: rect.midX + (CGFloat(world.x) - centerX) * scale,
+                y: rect.midY - (CGFloat(world.y) - centerY) * scale
+            )
+        }
+    }
+
+    private static func makeDrawingTransform(snapshot: PlanSnapshot, rect: CGRect) -> DrawingTransform {
+        let scale = min(
+            rect.width / CGFloat(snapshot.width * 1.12),
+            rect.height / CGFloat(snapshot.height * 1.12)
+        )
+        return DrawingTransform(
+            scale: max(scale, 1),
+            centerX: CGFloat((snapshot.minX + snapshot.maxX) / 2),
+            centerY: CGFloat((snapshot.minY + snapshot.maxY) / 2),
+            rect: rect
+        )
+    }
+
+    private static func polygonPath(points: [SIMD2<Double>], transform: DrawingTransform) -> CGPath {
+        let path = CGMutablePath()
+        guard let first = points.first else { return path }
+        path.move(to: transform.point(first))
+        for point in points.dropFirst() { path.addLine(to: transform.point(point)) }
+        path.closeSubpath()
+        return path
+    }
+
+    private static func drawWall(
+        context: CGContext,
+        start: CGPoint,
+        end: CGPoint,
+        thicknessPixels: CGFloat,
+        hasIssue: Bool
+    ) {
+        let dx = end.x - start.x
+        let dy = end.y - start.y
+        let length = max(hypot(dx, dy), 0.001)
+        let nx = -dy / length
+        let ny = dx / length
+        let half = thicknessPixels / 2
+        let path = CGMutablePath()
+        path.move(to: CGPoint(x: start.x + nx * half, y: start.y + ny * half))
+        path.addLine(to: CGPoint(x: end.x + nx * half, y: end.y + ny * half))
+        path.addLine(to: CGPoint(x: end.x - nx * half, y: end.y - ny * half))
+        path.addLine(to: CGPoint(x: start.x - nx * half, y: start.y - ny * half))
+        path.closeSubpath()
+        context.saveGState()
+        context.setFillColor((hasIssue ? UIColor.systemRed : UIColor.darkGray).withAlphaComponent(0.22).cgColor)
+        context.setStrokeColor((hasIssue ? UIColor.systemRed : UIColor.black).cgColor)
+        context.setLineWidth(hasIssue ? 2.2 : 1.2)
+        if hasIssue { context.setLineDash(phase: 0, lengths: [7, 4]) }
+        context.addPath(path)
+        context.drawPath(using: .fillStroke)
+        context.restoreGState()
+    }
+
+    private static func drawLine(
+        context: CGContext,
+        start: CGPoint,
+        end: CGPoint,
+        color: UIColor,
+        width: CGFloat
+    ) {
+        context.saveGState()
+        context.setStrokeColor(color.cgColor)
+        context.setLineWidth(width)
+        context.setLineCap(.round)
+        context.move(to: start)
+        context.addLine(to: end)
+        context.strokePath()
+        context.restoreGState()
+    }
+
+    private static func drawRotatedLabel(
+        context: CGContext,
+        text: String,
+        start: CGPoint,
+        end: CGPoint
+    ) {
+        let midpoint = CGPoint(x: (start.x + end.x) / 2, y: (start.y + end.y) / 2)
+        var angle = atan2(end.y - start.y, end.x - start.x)
+        if angle > .pi / 2 || angle < -.pi / 2 { angle += .pi }
+        context.saveGState()
+        context.translateBy(x: midpoint.x, y: midpoint.y)
+        context.rotate(by: angle)
+        drawText(
+            text,
+            in: CGRect(x: -58, y: -18, width: 116, height: 14),
+            font: .systemFont(ofSize: 8),
+            color: .darkGray,
+            alignment: .center
+        )
+        context.restoreGState()
+    }
+
+    private static func drawScaleBar(context: CGContext, rect: CGRect, scale: CGFloat) {
+        let oneMeter = scale
+        guard oneMeter > 8 else { return }
+        let start = CGPoint(x: rect.minX + 12, y: rect.maxY - 22)
+        let end = CGPoint(x: start.x + oneMeter, y: start.y)
+        drawLine(context: context, start: start, end: end, color: .label, width: 2)
+        drawLine(context: context, start: CGPoint(x: start.x, y: start.y - 5), end: CGPoint(x: start.x, y: start.y + 5), color: .label, width: 1)
+        drawLine(context: context, start: CGPoint(x: end.x, y: end.y - 5), end: CGPoint(x: end.x, y: end.y + 5), color: .label, width: 1)
+        drawText("1 m", in: CGRect(x: start.x, y: start.y + 5, width: oneMeter, height: 14), font: .systemFont(ofSize: 9), color: .label, alignment: .center)
+    }
+
+    private static func drawLegend(context: CGContext, rect: CGRect) {
+        let entries: [(String, UIColor)] = [
+            ("حائط", .darkGray), ("باب", .systemOrange), ("نافذة", .systemBlue),
+            ("فتحة", .systemTeal), ("جزء مكمل", .systemPurple), ("مشكلة", .systemRed)
+        ]
+        let width = rect.width / CGFloat(entries.count)
+        for (index, entry) in entries.enumerated() {
+            let x = rect.minX + CGFloat(index) * width
+            drawLine(
+                context: context,
+                start: CGPoint(x: x + 8, y: rect.midY),
+                end: CGPoint(x: x + 32, y: rect.midY),
+                color: entry.1,
+                width: 4
+            )
+            drawText(
+                entry.0,
+                in: CGRect(x: x + 37, y: rect.midY - 9, width: width - 42, height: 18),
+                font: .systemFont(ofSize: 9),
+                color: .label,
+                alignment: .right
+            )
+        }
+    }
+
+    private static func drawText(
+        _ text: String,
+        in rect: CGRect,
+        font: UIFont,
+        color: UIColor,
+        alignment: NSTextAlignment
+    ) {
+        let paragraph = NSMutableParagraphStyle()
+        paragraph.alignment = alignment
+        paragraph.lineBreakMode = .byTruncatingTail
+        (text as NSString).draw(
+            in: rect,
+            withAttributes: [
+                .font: font,
+                .foregroundColor: color,
+                .paragraphStyle: paragraph
+            ]
+        )
+    }
+
+    enum ExportError: LocalizedError {
+        case noRooms
+        case cannotEncodePNG
+        case cannotEncodeCSV
+
+        var errorDescription: String? {
+            switch self {
+            case .noRooms: return "لا توجد غرف مثبتة لتصديرها."
+            case .cannotEncodePNG: return "تعذر إنشاء صورة PNG للمخطط."
+            case .cannotEncodeCSV: return "تعذر ترميز ملف CSV."
+            }
+        }
+    }
+}
