+    private static func uniqueAssignments(_ assignments: [RoomWallAssignment]) -> [RoomWallAssignment] {
+        struct Key: Hashable {
+            let roomIndex: Int
+            let wallIdentifier: UUID
+        }
+        var values: [Key: RoomWallAssignment] = [:]
+        for assignment in assignments {
+            let key = Key(roomIndex: assignment.roomIndex, wallIdentifier: assignment.wallIdentifier)
+            if let current = values[key] {
+                if assignment.fragmentIndex < current.fragmentIndex { values[key] = assignment }
+            } else {
+                values[key] = assignment
+            }
+        }
+        return Array(values.values)
+    }
